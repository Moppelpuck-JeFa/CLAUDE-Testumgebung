<IfModule mod_rewrite.c>
RewriteEngine On

# Manche Apache/PHP-Konfigurationen auf Shared-Hosting reichen den
# Authorization-Header nicht automatisch an PHP durch. Diese Regel stellt
# sicher, dass er trotzdem ankommt.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# PT (PassThrough) ist auf FastCGI/PHP-FPM-Hosting nötig, damit REQUEST_URI
# nach dem Rewrite weiterhin den ursprünglich angefragten Pfad enthält.
RewriteRule ^ index.php [QSA,L,PT]
</IfModule>
