<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /imkerei/

# Authorization-Header durchreichen (manche Shared-Hosting-Setups blocken ihn
# sonst).
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Vorhandene Dateien/Ordner direkt ausliefern (u.a. api/index.php selbst,
# das über PATH_INFO angesprochen wird, z.B. api/index.php/standorte).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Alle anderen Anfragen an die React-App weiterreichen (Client-Side-Routing)
RewriteRule ^ index.html [L]
</IfModule>
